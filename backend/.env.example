# =============================================
# InsightBrief Backend - Environment Variables
# Copy this file to .env and fill in the values
# =============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/insightbrief

# Groq API (High-Speed Cloud AI Inference - Recommended)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API (Legacy / Alternative)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# News API (for real news fetching)
# Get your key from: https://newsapi.org/
NEWS_API_KEY=

# JWT Secret (for authentication, use a long random string)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ChromaDB (Vector Store for RAG)
CHROMA_DB_URL=http://localhost:8000

# Frontend Origin (for CORS)
CLIENT_URL=http://localhost:5173
