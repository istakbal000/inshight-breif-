# =============================================
# InsightBrief Backend - Environment Variables
# Copy this file to .env and fill in the values
# =============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/insightbrief

# Ollama (Local AI Model)
# Make sure Ollama is installed and running: https://ollama.com
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Google Gemini API (for embeddings - optional, keep if using RAG)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# News API (for real news fetching)
# Get your key from: https://newsapi.org/
NEWS_API_KEY=

# JWT Secret (for authentication, use a long random string)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ChromaDB (Vector Store for RAG)
CHROMA_DB_URL=http://localhost:8000

# Frontend Origin (for CORS)
CLIENT_URL=http://localhost:5173
